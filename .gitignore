# Environment & secrets — never commit this file
.env
.env.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Data vault / secrets-like content
# The processed dataset is published: database/findroid.db is a small (5.7MB)
# research artifact and IS committed. Only raw/large/generated artifacts are
# excluded below.
samples/
data/raw/
data/temporary/
data/fdroid_benign/
data/fdroid_tmp/
data/fdroid_index_v2.json
data/annotations/
data/candidates/
data/features/
data/validated/

# APK binaries are never allowed into the worktree (release sanitiser)
**/*.apk
**/*.apk.zip

# Generated reports (regenerate with `findroid run`)
reports/

# Logs
logs/
*.log

# OS
.DS_Store