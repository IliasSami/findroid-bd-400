# FinDroid-BD 400 — environment variables (copy to .env, never commit .env)
# All values are placeholders. Loaded only at runtime.

# AndroZoo research access key (institutional request + faculty sponsor required)
ANDROZOO_API_KEY=

# MalwareBazaar community API key (optional for public endpoints)
MALWAREBAZAAR_API_KEY=

# Root paths (default to repository layout when empty)
FINDROID_DATA_ROOT=
FINDROID_APK_VAULT=
FINDROID_DB_PATH=

# Mode controls
# development.mock_sources / mock_acquisition override in configs/project.yaml
FINDROID_MOCK_SOURCES=true
FINDROID_MOCK_ACQUISITION=true
FINDROID_ALLOW_REAL_APKS=false